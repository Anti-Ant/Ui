-- 5. CORE BACKGROUND ENGINE (Original pull-to-player system)
-- =============================================================================
local function pullEnemiesToPlayer(area, myRoot)
    if not area or not myRoot then return end
    for _, mob in ipairs(area:GetChildren()) do
        if mob:IsA("Model") then
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = true
                hrp.CFrame = myRoot.CFrame
            end
        end
    end
end

local function unanchorAreaEnemies(area)
    if not area then return end
    for _, obj in ipairs(area:GetDescendants()) do
        if obj:IsA("Model") then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = false
            end
        end
    end
end

