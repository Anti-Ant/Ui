-- =============================================================================
-- 7. FARM LOOP
-- =============================================================================
task.spawn(function()
    while true do
        if getgenv().SaberFarmingStates.FarmActive then
            pcall(function()
                local enabledFireStages = getEnabledStages(FireStages, "Fire")
                local enabledWaterStages = getEnabledStages(WaterStages, "Water")

                for _, stage in ipairs(enabledFireStages) do
                    if not getgenv().SaberFarmingStates.FarmActive then
                        break
                    end

                    waitForAreaClear(stage.area)
                    teleportTo(stage.tp)
                    task.wait(0.4)
                    attackCurrentArea()
                end

                for _, stage in ipairs(enabledWaterStages) do
                    if not getgenv().SaberFarmingStates.FarmActive then
                        break
                    end

                    waitForAreaClear(stage.area)
                    teleportTo(stage.tp)
                    task.wait(0.4)
                    attackCurrentArea()
                end
            end)
        end

        task.wait(0.2)
    end
end)
