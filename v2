local function getAreaEnemyHealths(area)
    local list = {}
    if not area then return list end
    for _, obj in ipairs(area:GetDescendants()) do
        if obj:IsA("Model") then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp then
                local ev = hrp:FindFirstChild("EnemyHealth")
                if ev then table.insert(list, ev) end
            end
        end
    end
    return list
end

local function waitForAreaClear(area)
    local enemies = getAreaEnemyHealths(area)
    if #enemies == 0 then return true end
    while true do
        local allDead = true
        for _, ev in ipairs(enemies) do
            if ev and ev.Value > 0 then
                allDead = false
                break
            end
        end
        if allDead then return true end
        task.wait(0.1)
    end
end

local function teleportTo(cf)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = cf
    end
end

