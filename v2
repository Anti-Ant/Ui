-- Main V2 farm loop (teleport-loop version for all elements)
task.spawn(function()
    local elementOrder = { "Fire", "Water", "Earth", "Plasma" }
    while true do
        if getgenv().SaberFarmingStates.V2.FarmActive then
            pcall(function()
                for _, element in ipairs(elementOrder) do
                    local tiers = { "Basic", "Advanced", "Master", "Grandmaster" }
                    local enabledStages = {}
                    for _, tier in ipairs(tiers) do
                        if getgenv().SaberFarmingStates.V2[element][tier] then
                            local config = getZoneTeleports(element, tier)
                            if config and config.area then
                                table.insert(enabledStages, { tier = tier, config = config })
                            end
                        end
                    end

                    for _, stage in ipairs(enabledStages) do
                        if not getgenv().SaberFarmingStates.V2.FarmActive then break end

                        local area = stage.config.area
                        local portalPath = stage.config.portal
                        local innerPath = stage.config.inner

                        -- Teleport to portal
                        local portal = getPath(portalPath)
                        if portal then
                            print("[V2] Teleporting to " .. stage.tier .. " " .. element .. " portal")
                            teleportTo(portal.CFrame)
                            task.wait(0.5)
                        end

                        -- Teleport to inner circle (offset)
                        local inner = getPath(innerPath)
                        if inner then
                            print("[V2] Teleporting to " .. stage.tier .. " " .. element .. " inner circle")
                            local offset = CFrame.new(15, 40, -37)
                            local targetCF = CFrame.new(
                                inner.Position + inner.CFrame:VectorToWorldSpace(offset.Position),
                                inner.Position
                            )
                            teleportTo(targetCF)
                            task.wait(0.3)
                        end

                        -- Wait for area to clear
                        print("[V2] Farming " .. stage.tier .. " " .. element .. "...")
                        waitForAreaClear(area)
                        print("[V2] " .. stage.tier .. " " .. element .. " cleared!")
                    end
                end
            end)
        end
        task.wait(0.2)
    end
end)
