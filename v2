-- Helper: get element health (0 = dead)
local function getElementHealth(area)
    if not area then return 0 end
    for _, obj in ipairs(area:GetDescendants()) do
        if obj:IsA("Model") then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp then
                local ev = hrp:FindFirstChild("EnemyHealth")
                if ev and ev.Value then
                    return ev.Value
                end
                -- Fallback: check Humanoid
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum then
                    return hum.Health
                end
            end
        end
    end
    return 0
end

-- Helper: wait until area is clear (health = 0)
local function waitForAreaClear(area)
    if not area then return true end
    local timeout = 120
    local start = tick()
    while true do
        local health = getElementHealth(area)
        if health <= 0 then
            return true
        end
        if tick() - start > timeout then
            print("[V2] Timeout waiting for area to clear, moving on.")
            return true
        end
        task.wait(0.5)
    end
end

-- Helper: teleport player to a CFrame
local function teleportTo(cf)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = cf
        LocalPlayer.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        LocalPlayer.Character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
    end
end

