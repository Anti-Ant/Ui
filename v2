-- Helper: get element health (0 = dead)
local function getElementHealth(area)
    if not area then return 0 end
    for _, obj in ipairs(area:GetDescendants()) do
        if obj:IsA("Model") then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp then
                local ev = hrp:FindFirstChild("EnemyHealth")
                if ev and ev.Value then return ev.Value end
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum then return hum.Health end
            end
        end
    end
    return 0
end

local function waitForAreaClear(area)
    if not area then return true end
    local timeout = 120
    local start = tick()
    while true do
        if getElementHealth(area) <= 0 then return true end
        if tick() - start > timeout then
            print("[V2] Timeout waiting for area to clear, moving on.")
            return true
        end
        task.wait(0.5)
    end
end

local function teleportTo(cf)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.CFrame = cf
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function getPath(path)
    local curr = workspace
    for part in path:gmatch("[^%.]+") do
        curr = curr:FindFirstChild(part)
        if not curr then return nil end
    end
    return curr
end

