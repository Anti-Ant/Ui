-- Get teleport CFrame: dynamic first, then fallback
local function getTeleportCFrame(element, tier, pathType)
    -- Build dynamic path
    local areaName = tier .. element .. "Area"  -- e.g., "AdvancedFireArea", "MasterWaterArea"
    local teleportPath
    if tier == "Basic" then
        -- Basic uses Map.ElementZones
        local mapPath = "Gameplay.Map.ElementZones." .. element .. "." .. element .. "Teleport." .. element .. "TeleportPart1"
        teleportPath = pathType == "portal" and mapPath or nil
        -- For inner circle: Gameplay.Map.ElementZones.<element>.InnerCircle
        if pathType == "inner" then
            teleportPath = "Gameplay.Map.ElementZones." .. element .. ".InnerCircle"
        end
    else
        -- Advanced, Master, Grandmaster use RegionsLoaded
        local base = "Gameplay.RegionsLoaded." .. areaName .. ".Important."
        if pathType == "portal" then
            teleportPath = base .. "Teleport." .. element .. "TeleportPart2"  -- they use Part2 for advanced+
        else -- inner
            teleportPath = base .. element .. ".InnerCircle"
        end
    end

    if teleportPath then
        local part = getPath(teleportPath)
        if part then
            print("[V2] ✅ Dynamic " .. pathType .. " found for " .. tier .. " " .. element)
            return part.CFrame
        end
    end

    -- Fallback to hardcoded
    local fallback = FALLBACK_CFRAMES[element] and FALLBACK_CFRAMES[element][tier] and FALLBACK_CFRAMES[element][tier][pathType]
    if fallback then
        print("[V2] 🔄 Using fallback " .. pathType .. " for " .. tier .. " " .. element)
        return fallback
    end

    warn("[V2] ❌ No " .. pathType .. " found for " .. tier .. " " .. element)
    return nil
end

-- Teleport function
local function teleportTo(cf)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.CFrame = cf
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        print("[V2] Teleported to", cf.Position)
    else
        warn("[V2] Character not ready")
    end
end

-- Health detection: wait until area's enemies are dead
local function waitForAreaClear(area)
    if not area then return true end
    local timeout = 120
    local start = tick()
    while true do
        local anyAlive = false
        for _, obj in ipairs(area:GetDescendants()) do
            if obj:IsA("Model") then
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local ev = hrp:FindFirstChild("EnemyHealth")
                    if ev and ev.Value then
                        if ev.Value > 0 then anyAlive = true break end
                    else
                        local hum = obj:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then anyAlive = true break end
                    end
                end
            end
        end
        if not anyAlive then
            print("[V2] Area cleared!")
            return true
        end
        if tick() - start > timeout then
            print("[V2] Timeout, moving on.")
            return true
        end
        wait(0.5)
    end
end

-- Get the area (the model containing enemies) for health check
local function getArea(element, tier)
    local Map = workspace:FindFirstChild("Gameplay") and workspace.Gameplay:FindFirstChild("Map")
    local RegionsLoaded = workspace:FindFirstChild("Gameplay") and workspace.Gameplay:FindFirstChild("RegionsLoaded")

    if tier == "Basic" then
        return Map and Map:FindFirstChild("ElementZones") and Map.ElementZones:FindFirstChild(element) and Map.ElementZones[element]:FindFirstChild(element)
    else
        local areaName = tier .. element .. "Area"
        local areaFolder = RegionsLoaded and RegionsLoaded:FindFirstChild(areaName)
        if areaFolder then
            return areaFolder:FindFirstChild("Important") and areaFolder.Important:FindFirstChild(element)
        end
    end
    return nil
end

