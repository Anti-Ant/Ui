-- Helper: get a path from workspace
local function getPath(path)
    local curr = workspace
    for part in path:gmatch("[^%.]+") do
        curr = curr:FindFirstChild(part)
        if not curr then return nil end
    end
    return curr
end

-- Main V2 farm loop (teleport-loop version)
task.spawn(function()
    while true do
        if getgenv().SaberFarmingStates.V2.FarmActive then
            pcall(function()
                -- Build list of enabled Fire stages
                local enabledFire = {}
                local fireTiers = { "Basic", "Advanced", "Master", "Grandmaster" }
                for _, tier in ipairs(fireTiers) do
                    if getgenv().SaberFarmingStates.V2.Fire[tier] then
                        local config = getZoneTeleports("Fire", tier)
                        if config and config.area then
                            table.insert(enabledFire, { tier = tier, config = config })
                        end
                    end
                end

                -- Build list of enabled Water stages
                local enabledWater = {}
                local waterTiers = { "Basic", "Advanced", "Master", "Grandmaster" }
                for _, tier in ipairs(waterTiers) do
                    if getgenv().SaberFarmingStates.V2.Water[tier] then
                        local config = getZoneTeleports("Water", tier)
                        if config and config.area then
                            table.insert(enabledWater, { tier = tier, config = config })
                        end
                    end
                end

                -- Process Fire stages
                for _, stage in ipairs(enabledFire) do
                    if not getgenv().SaberFarmingStates.V2.FarmActive then break end

                    local area = stage.config.area
                    local portalPath = stage.config.portal
                    local innerPath = stage.config.inner

                    -- Step 1: Teleport to portal
                    local portal = getPath(portalPath)
                    if portal then
                        print("[V2] Teleporting to " .. stage.tier .. " Fire portal")
                        teleportTo(portal.CFrame)
                        task.wait(0.5)
                    end

                    -- Step 2: Teleport to inner circle (with offset)
                    local inner = getPath(innerPath)
                    if inner then
                        print("[V2] Teleporting to " .. stage.tier .. " Fire inner circle")
                        local offset = CFrame.new(15, 40, -37)
                        local targetCF = CFrame.new(
                            inner.Position + inner.CFrame:VectorToWorldSpace(offset.Position),
                            inner.Position
                        )
                        teleportTo(targetCF)
                        task.wait(0.3)
                    end

                    -- Step 3: Wait for area to clear (health = 0)
                    print("[V2] Farming " .. stage.tier .. " Fire...")
                    waitForAreaClear(area)
                    print("[V2] " .. stage.tier .. " Fire cleared!")
                end

                -- Process Water stages
                for _, stage in ipairs(enabledWater) do
                    if not getgenv().SaberFarmingStates.V2.FarmActive then break end

                    local area = stage.config.area
                    local portalPath = stage.config.portal
                    local innerPath = stage.config.inner

                    -- Step 1: Teleport to portal
                    local portal = getPath(portalPath)
                    if portal then
                        print("[V2] Teleporting to " .. stage.tier .. " Water portal")
                        teleportTo(portal.CFrame)
                        task.wait(0.5)
                    end

                    -- Step 2: Teleport to inner circle (with offset)
                    local inner = getPath(innerPath)
                    if inner then
                        print("[V2] Teleporting to " .. stage.tier .. " Water inner circle")
                        local offset = CFrame.new(15, 40, -37)
                        local targetCF = CFrame.new(
                            inner.Position + inner.CFrame:VectorToWorldSpace(offset.Position),
                            inner.Position
                        )
                        teleportTo(targetCF)
                        task.wait(0.3)
                    end

                    -- Step 3: Wait for area to clear (health = 0)
                    print("[V2] Farming " .. stage.tier .. " Water...")
                    waitForAreaClear(area)
                    print("[V2] " .. stage.tier .. " Water cleared!")
                end
            end)
        end
        task.wait(0.2)
    end
end)
