-- 5. CORE BACKGROUND ENGINE (Handles Golems & Bosses with Explicit if/else)
-- =============================================================================
local function pullEnemiesToPlayer(area, myRoot)
    if not area or not myRoot then return end

    -- Match Untitled-2 behaviour: anchor and set CFrame directly for each mob model
    for _, mob in ipairs(area:GetChildren()) do
        if mob:IsA("Model") then
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = true
                hrp.CFrame = myRoot.CFrame
            end
        end
    end
end

local function unanchorAreaEnemies(area)
    if not area then return end

    for _, obj in ipairs(area:GetDescendants()) do
        if obj:IsA("Model") then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = false
            end
        end
    end
end

-- Loop which continuously tries to pull enabled-area mobs to the player.
task.spawn(function()
    while true do
        local success, err = pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local myRoot = LocalPlayer.Character.HumanoidRootPart

                -- FIRE AREAS
                local basicFire = game:GetService("Workspace").Gameplay.Map.ElementZones.Fire.Fire
