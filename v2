-- =============================================================================
-- 6. HELPER FUNCTIONS
-- =============================================================================
local function getAreaEnemyHealths(area)
    local list = {}

    if not area then
        return list
    end

    for _, obj in ipairs(area:GetDescendants()) do
        if obj:IsA("Model") then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp then
                local enemyHealth = hrp:FindFirstChild("EnemyHealth")
                if enemyHealth then
                    table.insert(list, enemyHealth)
                end
            end
        end
    end

    return list
end

local function waitForAreaClear(area)
    local enemies = getAreaEnemyHealths(area)

    if #enemies == 0 then
        return true
    end

    while true do
        local allDead = true

        for _, enemyHealth in ipairs(enemies) do
            if enemyHealth.Value > 0 then
                allDead = false
                break
            end
        end

        if allDead then
            return true
        end

        task.wait(0.05)
    end
end

local function teleportTo(cf)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = cf
    end
end

local function getEnabledStages(stageList, elementKey)
    local enabled = {}

    for _, stage in ipairs(stageList) do
        if getgenv().SaberFarmingStates[elementKey][stage.key] then
            table.insert(enabled, stage)
        end
    end

    return enabled
end

