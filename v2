-- =============================================================================
-- 5. CORE BACKGROUND ENGINE (Handles Golems & Bosses with Explicit if/else)
-- =============================================================================
local function pullEnemiesToPlayer(area, myRoot)
    if not area or not myRoot then return end

    -- Match Untitled-2 behaviour: anchor and set CFrame directly for each mob model
    for _, mob in ipairs(area:GetChildren()) do
        if mob:IsA("Model") then
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = true
                hrp.CFrame = myRoot.CFrame
            end
        end
    end
end

local function unanchorAreaEnemies(area)
    if not area then return end

    for _, obj in ipairs(area:GetDescendants()) do
        if obj:IsA("Model") then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = false
            end
        end
    end
end

-- Loop which continuously tries to pull enabled-area mobs to the player.
task.spawn(function()
    while true do
        local success, err = pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local myRoot = LocalPlayer.Character.HumanoidRootPart

                -- FIRE AREAS
                local basicFire = game:GetService("Workspace").Gameplay.Map.ElementZones.Fire.Fire
                if basicFire then
                    if getgenv().SaberFarmingStates.BringBasicFire then
                        pullEnemiesToPlayer(basicFire, myRoot)
                    else
                        unanchorAreaEnemies(basicFire)
                    end
                end

                local advFire = (game:GetService("ReplicatedStorage").HiddenRegions:FindFirstChild("AdvancedFireArea") and game:GetService("ReplicatedStorage").HiddenRegions.AdvancedFireArea.Important.Fire) or (game:GetService("Workspace").Gameplay.RegionsLoaded:FindFirstChild("AdvancedFireArea") and game:GetService("Workspace").Gameplay.RegionsLoaded.AdvancedFireArea.Important.Fire)
                if advFire then
                    if getgenv().SaberFarmingStates.BringAdvancedFire then
                        pullEnemiesToPlayer(advFire, myRoot)
                    else
                        unanchorAreaEnemies(advFire)
                    end
                end

                local masterFire = (game:GetService("ReplicatedStorage").HiddenRegions:FindFirstChild("MasterFireArea") and game:GetService("ReplicatedStorage").HiddenRegions.MasterFireArea.Important.Fire) or (game:GetService("Workspace").Gameplay.RegionsLoaded:FindFirstChild("MasterFireArea") and game:GetService("Workspace").Gameplay.RegionsLoaded.MasterFireArea.Important.Fire)
                if masterFire then
                    if getgenv().SaberFarmingStates.BringMasterFire then
                        pullEnemiesToPlayer(masterFire, myRoot)
                    else
                        unanchorAreaEnemies(masterFire)
                    end
                end

                local gmFire = (game:GetService("ReplicatedStorage").HiddenRegions:FindFirstChild("GrandmasterFireArea") and game:GetService("ReplicatedStorage").HiddenRegions.GrandmasterFireArea.Important.Fire) or (game:GetService("Workspace").Gameplay.RegionsLoaded:FindFirstChild("GrandmasterFireArea") and game:GetService("Workspace").Gameplay.RegionsLoaded.GrandmasterFireArea.Important.Fire)
                if gmFire then
                    if getgenv().SaberFarmingStates.BringGrandmasterFire then
                        pullEnemiesToPlayer(gmFire, myRoot)
                    else
                        unanchorAreaEnemies(gmFire)
                    end
                end

                -- WATER AREAS
                local basicWater = game:GetService("Workspace").Gameplay.Map.ElementZones.Water.Water
                if basicWater then
                    if getgenv().SaberFarmingStates.BringBasicWater then
                        pullEnemiesToPlayer(basicWater, myRoot)
                    else
                        unanchorAreaEnemies(basicWater)
                    end
                end

                local advWater = (game:GetService("ReplicatedStorage").HiddenRegions:FindFirstChild("AdvancedWaterArea") and game:GetService("ReplicatedStorage").HiddenRegions.AdvancedWaterArea.Important.Water) or (game:GetService("Workspace").Gameplay.RegionsLoaded:FindFirstChild("AdvancedWaterArea") and game:GetService("Workspace").Gameplay.RegionsLoaded.AdvancedWaterArea.Important.Water)
                if advWater then
                    if getgenv().SaberFarmingStates.BringAdvancedWater then
                        pullEnemiesToPlayer(advWater, myRoot)
                    else
                        unanchorAreaEnemies(advWater)
                    end
                end

                local masterWater = (game:GetService("ReplicatedStorage").HiddenRegions:FindFirstChild("MasterWaterArea") and game:GetService("ReplicatedStorage").HiddenRegions.MasterWaterArea.Important.Water) or (game:GetService("Workspace").Gameplay.RegionsLoaded:FindFirstChild("MasterWaterArea") and game:GetService("Workspace").Gameplay.RegionsLoaded.MasterWaterArea.Important.Water)
                if masterWater then
                    if getgenv().SaberFarmingStates.BringMasterWater then
                        pullEnemiesToPlayer(masterWater, myRoot)
                    else
                        unanchorAreaEnemies(masterWater)
                    end
                end

                local gmWater = (game:GetService("ReplicatedStorage").HiddenRegions:FindFirstChild("GrandmasterWaterArea") and game:GetService("ReplicatedStorage").HiddenRegions.GrandmasterWaterArea.Important.Water) or (game:GetService("Workspace").Gameplay.RegionsLoaded:FindFirstChild("GrandmasterWaterArea") and game:GetService("Workspace").Gameplay.RegionsLoaded.GrandmasterWaterArea.Important.Water)
                if gmWater then
                    if getgenv().SaberFarmingStates.BringGrandmasterWater then
                        pullEnemiesToPlayer(gmWater, myRoot)
                    else
                        unanchorAreaEnemies(gmWater)
                    end
                end
            end
        end)

        if not success then
            warn("[FarmLoop] Error in pull loop:", err)
        end

        -- short wait to avoid spamming
        task.wait(0.08)
    end
end)
