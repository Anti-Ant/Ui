-- =============================================================================
-- 1. STATE INITIALIZATION
-- =============================================================================
getgenv().SaberFarmingStates = {
    BringBasicFire = false,
    BringAdvancedFire = false,
    BringMasterFire = false,
    BringGrandmasterFire = false,
    
    BringBasicWater = false,
    BringAdvancedWater = false,
    BringMasterWater = false,
    BringGrandmasterWater = false
}

local LocalPlayer = game:GetService("Players").LocalPlayer

-- =============================================================================
-- 2. BOOT WALLY V3 UI LIBRARY & CREATE MAIN WINDOW
-- =============================================================================
-- Loads the exact repository backup path required for Wally UI v3
local library = loadstring(game:HttpGet(('https://raw.githubusercontent.com/Anti-Ant/Ui/refs/heads/main/Wally%20Ui')))()
local Window = library:CreateWindow("Saber Sim Hub")

-- =============================================================================
-- 3. FIRE ELEMENTS TAB & TOGGLES (Wally Folder Pattern)
-- =============================================================================
local FireFolder = Window:CreateFolder("Fire Elements")

FireFolder:Toggle("Basic Fire Golem", function(bool)
    getgenv().SaberFarmingStates.BringBasicFire = bool
end)

FireFolder:Toggle("Advanced Fire Golem", function(bool)
    getgenv().SaberFarmingStates.BringAdvancedFire = bool
end)

FireFolder:Toggle("Master Fire Golem", function(bool)
    getgenv().SaberFarmingStates.BringMasterFire = bool
end)

FireFolder:Toggle("Grandmaster Fire Golem", function(bool)
    getgenv().SaberFarmingStates.BringGrandmasterFire = bool
end)

-- =============================================================================
-- 4. WATER ELEMENTS TAB & TOGGLES
-- =============================================================================
local WaterFolder = Window:CreateFolder("Water Elements")

WaterFolder:Toggle("Basic Water Mobs", function(bool)
    getgenv().SaberFarmingStates.BringBasicWater = bool
end)

WaterFolder:Toggle("Advanced Water Mobs", function(bool)
    getgenv().SaberFarmingStates.BringAdvancedWater = bool
end)

WaterFolder:Toggle("Master Water Mobs", function(bool)
    getgenv().SaberFarmingStates.BringMasterWater = bool
end)

WaterFolder:Toggle("Grandmaster Water Mobs", function(bool)
    getgenv().SaberFarmingStates.BringGrandmasterWater = bool
end)

-- =============================================================================
-- 5. CORE BACKGROUND ENGINE (Reads Wally layout state switches)
-- =============================================================================
task.spawn(function()
    while true do
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local myRoot = LocalPlayer.Character.HumanoidRootPart
                
                -- ==================== FIRE ZONES PROCESSING ====================
                -- 1. Basic Fire Golem
                local basicFire = game:GetService("Workspace").Gameplay.Map.ElementZones.Fire.Fire
                if basicFire then
                    for _, golem in pairs(basicFire:GetChildren()) do
                        if golem.Name == "Fire Golem" then
                            local root = golem:FindFirstChild("HumanoidRootPart")
                            if root then
                                root.Anchored = getgenv().SaberFarmingStates.BringBasicFire
                                if getgenv().SaberFarmingStates.BringBasicFire then root.CFrame = myRoot.CFrame end
                            end
                        end
                    end
                end

                -- 2. Advanced Fire Golem
                local advFire = game:GetService("ReplicatedStorage").HiddenRegions.AdvancedFireArea.Important.Fire
                if advFire then
                    for _, golem in pairs(advFire:GetChildren()) do
                        if golem.Name == "Fire Golem" then
                            local root = golem:FindFirstChild("HumanoidRootPart")
                            if root then
                                root.Anchored = getgenv().SaberFarmingStates.BringAdvancedFire
                                if getgenv().SaberFarmingStates.BringAdvancedFire then root.CFrame = myRoot.CFrame end
                            end
                        end
                    end
                end

                -- 3. Master Fire Golem
                local masterFire = game:GetService("ReplicatedStorage").HiddenRegions.MasterFireArea.Important.Fire
                if masterFire then
                    for _, golem in pairs(masterFire:GetChildren()) do
                        if golem.Name == "Fire Golem" then
                            local root = golem:FindFirstChild("HumanoidRootPart")
                            if root then
                                root.Anchored = getgenv().SaberFarmingStates.BringMasterFire
                                if getgenv().SaberFarmingStates.BringMasterFire then root.CFrame = myRoot.CFrame end
                            end
                        end
                    end
                end

                -- 4. Grandmaster Fire Golem
                local gmFire = game:GetService("ReplicatedStorage").HiddenRegions.GrandmasterFireArea.Important.Fire
                if gmFire then
                    for _, golem in pairs(gmFire:GetChildren()) do
                        if golem.Name == "Fire Golem" then
                            local root = golem:FindFirstChild("HumanoidRootPart")
                            if root then
                                root.Anchored = getgenv().SaberFarmingStates.BringGrandmasterFire
                                if getgenv().SaberFarmingStates.BringGrandmasterFire then root.CFrame = myRoot.CFrame end
                            end
                        end
                    end
                end

                -- ==================== WATER ZONES PROCESSING ====================
                -- 1. Basic Water Mobs
                local basicWater = game:GetService("Workspace").Gameplay.Map.ElementZones.Water.Water
                if basicWater then
                    for _, mob in pairs(basicWater:GetChildren()) do
                        if mob.Name:find("Water Golem") then
                            local root = mob:FindFirstChild("HumanoidRootPart")
                            if root then
                                root.Anchored = getgenv().SaberFarmingStates.BringBasicWater
                                if getgenv().SaberFarmingStates.BringBasicWater then root.CFrame = myRoot.CFrame end
                            end
                        end
                    end
                end

                -- 2. Advanced Water Mobs
                local advWater = game:GetService("ReplicatedStorage").HiddenRegions.AdvancedWaterArea.Important.Water
                if advWater then
                    for _, mob in pairs(advWater:GetChildren()) do
                        if mob.Name:find("Water Golem") then
                            local root = mob:FindFirstChild("HumanoidRootPart")
                            if root then
                                root.Anchored = getgenv().SaberFarmingStates.BringAdvancedWater
                                if getgenv().SaberFarmingStates.BringAdvancedWater then root.CFrame = myRoot.CFrame end
                            end
                        end
                    end
                end

                -- 3. Master Water Mobs
                local masterWater = game:GetService("ReplicatedStorage").HiddenRegions.MasterWaterArea.Important.Water
                if masterWater then
                    for _, mob in pairs(masterWater:GetChildren()) do
                        if mob.Name:find("Water Golem") then
                            local root = mob:FindFirstChild("HumanoidRootPart")
                            if root then
                                root.Anchored = getgenv().SaberFarmingStates.BringMasterWater
                                if getgenv().SaberFarmingStates.BringMasterWater then root.CFrame = myRoot.CFrame end
                            end
                        end
                    end
                end

                -- 4. Grandmaster Water Mobs
                local gmWater = game:GetService("ReplicatedStorage").HiddenRegions.GrandmasterWaterArea.Important.Water
                if gmWater then
                    for _, mob in pairs(gmWater:GetChildren()) do
                        if mob.Name:find("Water Golem") then
                            local root = mob:FindFirstChild("HumanoidRootPart")
                            if root then
                                root.Anchored = getgenv().SaberFarmingStates.BringGrandmasterWater
                                if getgenv().SaberFarmingStates.BringGrandmasterWater then root.CFrame = myRoot.CFrame end
                            end
                        end
                    end
                end

            end
        end)
        task.wait()
    end
end)
